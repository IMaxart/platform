# Environment
NODE_ENV=development

# Domain (used for Traefik routing: platform.$ADMIN_DOMAIN, status.$ADMIN_DOMAIN)
ADMIN_DOMAIN=localhost

# Platform app
HASH_SECRET=change-me-to-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars
PASSKEY_RP_ID=localhost

# Admin user (created on first run if no users exist)
ADMIN_EMAIL=admin@imaxart.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=AdminPassword123!

# Email (Mailpit for local dev, external SMTP for production)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IMaxart Platform <noreply@localhost>

# Database (shared PostgreSQL for both apps)
POSTGRES_USER=imaxart
POSTGRES_PASSWORD=imaxart
POSTGRES_DB=imaxart
