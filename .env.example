# Environment
NODE_ENV=development

# Domain (used for Traefik routing: platform.$ADMIN_DOMAIN, status.$ADMIN_DOMAIN)
ADMIN_DOMAIN=localhost

# Platform app
HASH_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Database (shared PostgreSQL for both apps)
POSTGRES_USER=imaxart
POSTGRES_PASSWORD=imaxart
POSTGRES_DB=imaxart
