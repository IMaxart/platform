{
  "name": "platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:watch": "turbo test -- --watch",
    "bench": "turbo bench",
    "db:generate": "turbo db:generate --filter=@platform/db",
    "db:migrate": "turbo db:migrate --filter=@platform/db",
    "db:push": "turbo db:push --filter=@platform/db",
    "db:studio": "turbo db:studio --filter=@platform/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@prettier/plugin-oxc": "^0.1.3",
    "@types/bun": "^1.3.9",
    "@types/node": "^25.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
